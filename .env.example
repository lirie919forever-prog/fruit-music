JAMENDO_CLIENT_ID=

# LX Music is disabled by default. Set this explicit opt-in flag to true only
# after reviewing the selected provider's terms and your right to use its data.
# NEXT_PUBLIC_LX_ENABLED=true

# Optional LX Music HTTP API endpoint. This value is used by server-side code
# only and is not exposed to the browser.
# Available endpoints:
#   https://lx.xiaomusic.dpdns.org
#   https://lxmusicapi.onrender.com
# LX_API_BASE=https://lx.xiaomusic.dpdns.org

# Optional dedicated stream resolver. This fallback is used when LX_API_BASE is unavailable.
# LX_RESOLVER_BASE=https://lxmusicapi.onrender.com

# Default audio quality for LX Music streams: 128 | 192 | 320 | hires
# LX_DEFAULT_LEVEL=320

# Optional comma-separated HTTPS hostnames returned by the resolver for media redirects.
# Keep this explicit; resolver responses are never trusted as arbitrary proxy targets.
# LX_APPROVED_MEDIA_HOSTS=cdn.example.com,storage.example.com

# This application does not load or execute arbitrary LX custom-source scripts.
# Deployment operators remain responsible for provider terms, content rights,
# and any licensing requirements that apply in their jurisdiction.
